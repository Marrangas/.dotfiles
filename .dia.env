# Workspace Environment: dia
# Loaded by Bash, Makefile, and Ansible.
# Generated automatically from helpers/config.sh.

WORKSPACE_NAME="dia"
DOTFILE_LAYER="ALL"

export DOTFILE_FONT="FiraCode Nerd Font"
export DOTFILE_FONT_SIZE="12"
export DOTFILE_STYLE="dark"
export DOTFILE_THEME="tokyonight"
export DOTFILE_TERMINAL="ghostty"
export DOTFILE_SEARCH_TOOL="ripgrep"
export DOTFILE_TERMINAL_OPACITY="0.85"

export DOTFILE_LSP_SERVERS="pyright,gopls,lua_ls"

DOTFILE_PACKAGES=(
  "aerospace"
  "bat"
  "copyq"
  "editorconfig"
  "fonts"
  "fzf"
  "garden"
  "gemini"
  "ghostty"
  "git"
  "htop"
  "macOs"
  "nvim"
  "nvimpager"
  "scripts"
  "starship"
  "tmux"
  "vim"
  "zsh"
)

