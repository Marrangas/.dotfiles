)

DOTFILE_SCRIPTS=(
  "scripts/.local/bin/sessionizer"
  "scripts/.local/bin/.fzf-gcloud.plugin.zsh"
  "scripts/.local/bin/whip"
)

DOTFILE_STARSHIP=(
  "starship/.config/starship/starship.toml"
)

DOTFILE_TMUX=(
  "tmux/.config/tmux/tmux.conf"
)

DOTFILE_VIM=(
  "vim/.config/vim/vimrc"
)

DOTFILE_ZSH=(
  "zsh/.zshrc"
)

DEPLOY_FILES=(
  "aerospace/.config/aerospace/aerospace.toml"
  "bat/.config/bat/config"
  "copyq/.config/copyq/copyq-commands.ini"
  "copyq/.config/copyq/copyq-filter.ini"
  "copyq/.config/copyq/copyq_geometry.ini"
  "copyq/.config/copyq/copyq_tabs.ini"
