# Workspace Environment: dia
# Loaded by Bash, Makefile, and Ansible.
# Generated automatically from build.sh.

WORKSPACE_NAME="dia"
DOTFILE_LAYER="ALL"

export DOTFILE_FONT="FiraCode Nerd Font"
export DOTFILE_FONT_SIZE="12"
export DOTFILE_STYLE="dark"
export DOTFILE_THEME="tokyonight"
export DOTFILE_TERMINAL="ghostty"
export DOTFILE_SEARCH_TOOL="ripgrep"

export DOTFILE_LSP_SERVERS="pyright,gopls,lua_ls"

DOTFILE_PACKAGES=(
  "git"
  "zsh"
  "vim"
  "nvim"
  "tmux"
  "ghostty"
  "nvimpager"
  "aerospace"
  "editorconfig"
  "bat"
  "fzf"
  "copyq"
  "starship"
  "garden"
  "gemini"
  "htop"
  "macOs"
  "scripts"
)

DEPLOY_FILES=(
  "git/.config/git/config"
  "git/.config/git/ignore"
  "zsh/.zshrc"
  "vim/.config/vim/vimrc"
  "nvim/.config/nvim/init.lua"
