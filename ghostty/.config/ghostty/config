window-decoration = none
macos-option-as-alt = left
macos-titlebar-style = hidden
macos-non-native-fullscreen = true
cursor-style-blink = false
mouse-hide-while-typing = true
clipboard-paste-protection = false

theme = Catppuccin Macchiato

font-family = "FiraCode Nerd Font"
font-size = 12
font-feature = "calt"
font-feature = "liga"
font-feature = "zero" # Slashed zero for better variability
font-style = "Regular"
font-style-bold = "Bold"
font-style-italic = "Italic"
font-style-bold-italic = "Bold Italic"

# macOS CoreText Font Rendering & Smoothing (Optimizations for low-res monitors)
# Artificially thickens the font stroke to prevent text from looking thin or jagged
font-thicken = false
font-thicken-strength = 20

# Enhance blending and colorspace for smoother, richer text edges
alpha-blending = native
window-colorspace = display-p3

# Keybindings for word navigation (Option+b / Option+f) and line-start (Command+b)
keybind = alt+b=esc:b
keybind = alt+f=esc:f
keybind = cmd+b=text:\x01

# Load environment-specific overrides generated by bootstrap
config-file = ?env.conf
