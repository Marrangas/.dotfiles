# bat configuration file
# Managed by dotfiles

# Set the theme to Catppuccin Macchiato (if installed)
--theme="Catppuccin Mocha"

# Show only line numbers and git changes (cleaner look, no boxes)
--style="changes"

# Case-insensitive search
--map-syntax "*.jenkinsfile:Groovy"
--map-syntax "*.props:Java Properties"