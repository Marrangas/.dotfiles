[user]
	name = "Marrangas"
	email = me@marrangas.es

[core]
	excludesFile = ~/.config/git/ignore
	editor = "sh -c 'if command -v nvim >/dev/null 2>&1; then nvim \"$@\"; elif command -v vim; then vim \"$@\"; else vi \"$@\"; fi' --"
    pager = "page -q 1000"

[pager]
   branch = false

[init]
	defaultbranch = master

[color]
	ui = auto
	diff = auto
	status = auto
	branch = auto
	pager = true

[pull]
	rebase = true
	autostash = true
	prune = true

[push]
	default = current

[merge]
	tool = nvimdiff
	conflictstyle = diff3

[rebase]
  autostash = true


[mergetool]
	prompt = false

[alias]
        chof = "!git add $1 && git commit --amend --no-edit"
        last = "!git --no-pager log -1 head"
        unstage = reset head --
        parent = rev-parse --abbrev-ref --symbolic-full-name @{u}
        tree = log --graph --date=format:'%y-%m-%d %h:%m' --pretty='format:%c(auto)%h %c(red)%d%c(reset)%n%c(yellow)%an -> %ae%n%c(green)%ad%c(reset) %s%n' --all
        authors = shortlog --summary --numbered
        usage = "!git log --format=format: --name-only --since='1 year ago' | sort | uniq -c | sort -nr | head -50"
        months = "!git log --format='%ad' --date=format:'%y-%m' | sort | uniq -c"
        stats = "!f() { git log --format='%an' | sort -u | while read -r author; do stats=$(git log --author=\"$author\" --no-renames --pretty=tformat: --numstat | awk '{ add += $1; subs += $2 } end { printf \"added: %-6d | removed: %-6d | total: %-6d\", add, subs, add - subs }'); printf \"%-30s : %s\\n\" \"$author\" \"$stats\"; done; }; f"
        white = "!sh -c 'git diff -u1 -w --no-color --src-prefix=a/ --dst-prefix=b/ \"$@\" | git apply --cached --ignore-whitespace --unidiff-zero -'"
        hand = "!f() { \
            if command -v fzf >/dev/null 2>&1; then \
                git branch -a --format='%(refname:short)' | sed 's|^origin/||' | sort -u | fzf \
                    --header 'enter: checkout | ctrl-n: create branch [from query] | ctrl-x: delete local branch' \
                    --bind 'enter:become(git checkout {1})' \
                    --bind 'ctrl-n:become(git checkout -b {q})' \
                    --bind 'ctrl-x:execute(git branch -d {1})+reload(git branch -a --format="%(refname:short)" | sed "s|^origin/||" | sort -u)'; \
            fi; \
        }; f"
        sneak = "!f() { \
            if command -v fzf >/dev/null 2>&1; then \
              git log --graph --color=always --format='%c(auto)%h%d %s %c(black)%c(bold)%cr' $@ | \
              fzf --ansi --no-sort --reverse --tiebreak=index \
                  --prompt=' git log > ' \
                  --preview 'git show --color=always $(echo {} | grep -e -o [a-f0-9]{7,40} | head -n1)' \
                  --preview-window=right:65% \
                  --bind 'enter:execute(git show $(echo {} | grep -e -o [a-f0-9]{7,40} | head -n1) | bat --color=always)'; \
            fi; \
        }; f"


[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge --skip -- %f
	process = git-lfs filter-process --skip
	required = true

[credential]
	helper = osxkeychain

[http]
	sslVerify = true
