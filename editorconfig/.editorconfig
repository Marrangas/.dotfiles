root = true

# Universal settings
# Linux & macOS:  LF (\n)
# Since macOS X (and now macOS Sequoia), Apple transitioned to Unix standards.

# Windows: CRLF (\r\n)
# This is a legacy of typewriter mechanics:
# the "Carriage" returns to the start of the line (CR),
# and the paper "Feeds" up one line (LF).

# Classic Mac (Pre-OS X): CR (\r)
# Note: You will almost never see th  is today unless you are working with legacy files from the 90s.
[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,js,ts,jsx,tsx,html,css,scss,toml}]
indent_size = 2

[*.{conf,ini}]
indent_size = 2

# Python follows PEP8
[*.py,*.lua]
indent_size = 4
indent_style = space

# Tab-based indentation for makefiles and go
[{Makefile,*.go,*.sh}]
indent_size = 4
indent_style = tab

[{.zshrc,.bashrc,.bash_profile,.zprofile,*.zsh,*.zsh-theme}]
indent_size = 2
indent_style = space

# Markdown specific rules
# indent_size for the frontmatter
[*.md]
indent_size = 2
max_line_length = 80
trim_trailing_whitespace = false
