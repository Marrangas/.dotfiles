#!/usr/bin/env bash

# --- Documentation ---
# sessionizer: Fast project switcher for tmux.
# Uses fzf to select a directory and creates/attaches to a tmux session.
# ---------------------

if [[ $# -eq 1 ]]; then
    selected=$1
else
    # Dynamically find projects in common locations
    selected=$( cat <(echo "$HOME/Documents/mrgs/.dotfiles") \
                    <(echo "$HOME/Documents/mrgs/.secrets") \
                    <(find "$HOME/Documents/mrgs" \
                        -mindepth 1 -maxdepth 1 -type d  ! -name '.*' \
                    ) \
                    <(find "$HOME/Documents/alt/" \
                        -mindepth 1 -maxdepth 1 -type d  ! -name '.*' \
                    ) \
                    <(find "$HOME/Documents/dgrp/" \
                        -mindepth 1 -maxdepth 1 -type d  ! -name '.*' \
                    ) \
                    <(find "$HOME/Documents/dgrp/t-oc" \
                        -mindepth 1 -maxdepth 1 -type d  ! -name '.*' \
                    )\
                    <(find "$HOME/Documents/" \
                        -mindepth 1 -maxdepth 2 -type d  ! -name '.*' \
                    ) | sort -u \
                    | fzf --prompt="󱫋 Select Project: "
    )
fi

if [[ -z $selected ]]; then
    exit 0
fi

# Sanitize session name (periods aren't allowed in tmux session names)
selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

# If tmux is not running, start it
if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$selected_name" -c "$selected"
    exit 0
fi

# If the session doesn't exist, create it in the background
if ! tmux has-session -t="$selected_name" 2> /dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

# Switch to the session
if [[ -z $TMUX ]]; then
    tmux attach -t "$selected_name"
else
    tmux switch-client -t "$selected_name"
fi
