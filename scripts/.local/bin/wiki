#!/usr/bin/env bash

set -euo pipefail

# Terminal colors
if [[ -t 1 ]]; then
    GREEN="\033[0;32m"
    YELLOW="\033[0;33m"
    RED="\033[0;31m"
    CYAN="\033[0;36m"
    BOLD="\033[1m"
    NC="\033[0m" # No Color
else
    GREEN=""
    YELLOW=""
    RED=""
    CYAN=""
    BOLD=""
    NC=""
fi

DEFAULT_WIKI_DIR="${WIKI_TARGET:-$HOME/Documents/wiki/atlas}"

usage() {
    cat << EOF
Usage: wiki <command> [options]

Commands:
  link      Link files in the current folder to the wiki atlas.

Global Options:
  -h, --help  Show this help message.

Run 'wiki <command> --help' for command-specific options.
EOF
}

usage_link() {
    cat << EOF
Usage: wiki link [options] [source_dir]

Link all files in [source_dir] (default: current directory) to the wiki atlas.
Includes hidden (dotted) files, except common system/VCS files like .DS_Store.

Options:
  -t, --target <dir>  Target wiki directory (default: \$WIKI_TARGET or ~/Documents/wiki/atlas if unset; currently: ${WIKI_TARGET:-not set})
  -f, --force         Force overwrite of existing files/links in target
  -n, --dry-run       Show what would be linked without making changes
  -h, --help          Show this help message
EOF
}

is_ignored() {
    local filename="$1"
    # Case-insensitive check for .ds_store
    local lower_file
    lower_file=$(echo "$filename" | tr '[:upper:]' '[:lower:]')

    if [[ "$lower_file" == ".ds_store" ]]; then
        return 0
    fi

    case "$filename" in
        .git|.gitattributes|.gitignore|.gitmodules|.stow-local-ignore)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

cmd_link() {
    local source_dir="$1"
    local wiki_dir="$2"
    local force="$3"
    local dry_run="$4"

    # Expand source_dir path
    if [[ ! -d "$source_dir" ]]; then
        echo -e "${RED}Error: Source directory '$source_dir' does not exist.${NC}" >&2
        exit 1
    fi

    local src_dir
    src_dir=$(cd "$source_dir" && pwd)

    # Expand wiki_dir path (resolving ~/ safely)
    wiki_dir="${wiki_dir/#\~/$HOME}"

    if [[ ! -d "$wiki_dir" ]]; then
        if "$dry_run"; then
            echo -e "${CYAN}[Dry Run] Would create target wiki directory:${NC} $wiki_dir"
        else
            echo "Target wiki directory '$wiki_dir' does not exist. Creating it..."
            mkdir -p "$wiki_dir"
        fi
    fi

    local file_count=0
    local linked_count=0
    local skipped_count=0
    local conflict_count=0

    # Read files in source_dir (including hidden/dotted, excluding subdirectories)
    # Using find to list files safely, even those with spaces in their names.
    while IFS= read -r -d '' file; do
        local filename
        filename=$(basename "$file")

        if is_ignored "$filename"; then
            skipped_count=$((skipped_count + 1))
            continue
        fi

        file_count=$((file_count + 1))
        local abs_file="$file"
        local target="$wiki_dir/$filename"

        if [[ -e "$target" || -L "$target" ]]; then
            if [[ -L "$target" ]]; then
                local current_target
                current_target=$(readlink "$target")
                if [[ "$current_target" == "$abs_file" ]]; then
                    echo -e "${GREEN}✓ Already linked:${NC} $filename"
                    linked_count=$((linked_count + 1))
                else
                    if "$force"; then
                        if "$dry_run"; then
                            echo -e "${CYAN}[Dry Run] Would recreate symlink:${NC} $filename ($target -> $abs_file)"
                        else
                            rm "$target"
                            ln -s "$abs_file" "$target"
                            echo -e "${GREEN}✓ Updated symlink:${NC} $filename -> $abs_file"
                        fi
                        linked_count=$((linked_count + 1))
                    else
                        echo -e "${YELLOW}⚠ Conflict:${NC} Symlink $filename already exists but points to '$current_target' (use --force to overwrite)"
                        conflict_count=$((conflict_count + 1))
                    fi
                fi
            elif [[ -d "$target" ]]; then
                echo -e "${RED}✗ Error:${NC} $filename already exists as a directory in $wiki_dir"
                conflict_count=$((conflict_count + 1))
            else
                if "$force"; then
                    if "$dry_run"; then
                        echo -e "${CYAN}[Dry Run] Would replace regular file with symlink:${NC} $filename ($target -> $abs_file)"
                    else
                        rm "$target"
                        ln -s "$abs_file" "$target"
                        echo -e "${GREEN}✓ Replaced file with symlink:${NC} $filename -> $abs_file"
                    fi
                    linked_count=$((linked_count + 1))
                else
                    echo -e "${YELLOW}⚠ Conflict:${NC} Regular file $filename already exists in $wiki_dir (use --force to overwrite)"
                    conflict_count=$((conflict_count + 1))
                fi
            fi
        else
            if "$dry_run"; then
                echo -e "${CYAN}[Dry Run] Would link:${NC} $filename -> $abs_file"
            else
                ln -s "$abs_file" "$target"
                echo -e "${GREEN}✓ Linked:${NC} $filename -> $abs_file"
            fi
            linked_count=$((linked_count + 1))
        fi
    done < <(find "$src_dir" -maxdepth 1 -type f -print0)

    echo
    if "$dry_run"; then
        echo -e "${BOLD}Dry Run Summary:${NC}"
        echo -e "  Files evaluated: $file_count"
        echo -e "  To be linked/updated: $linked_count"
        echo -e "  Conflicts: $conflict_count"
        echo -e "  System files skipped: $skipped_count"
    else
        echo -e "${BOLD}Summary:${NC}"
        echo -e "  Files evaluated: $file_count"
        echo -e "  Successfully linked/active: $linked_count"
        echo -e "  Conflicts (skipped): $conflict_count"
        echo -e "  System files skipped: $skipped_count"
    fi
}

# Main command dispatcher
if [[ $# -lt 1 ]]; then
    usage
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
    link)
        WIKI_DIR="$DEFAULT_WIKI_DIR"
        FORCE=false
        DRY_RUN=false
        SOURCE_DIR="."

        while [[ $# -gt 0 ]]; do
            case "$1" in
                -t|--target)
                    if [[ -n "${2:-}" ]]; then
                        WIKI_DIR="$2"
                        shift 2
                    else
                        echo -e "${RED}Error: --target requires an argument.${NC}" >&2
                        exit 1
                    fi
                    ;;
                -f|--force)
                    FORCE=true
                    shift
                    ;;
                -n|--dry-run)
                    DRY_RUN=true
                    shift
                    ;;
                -h|--help)
                    usage_link
                    exit 0
                    ;;
                -*)
                    echo -e "${RED}Error: Unknown option $1${NC}" >&2
                    usage_link
                    exit 1
                    ;;
                *)
                    SOURCE_DIR="$1"
                    shift
                    ;;
            esac
        done

        cmd_link "$SOURCE_DIR" "$WIKI_DIR" "$FORCE" "$DRY_RUN"
        ;;
    help|-h|--help)
        usage
        exit 0
        ;;
    *)
        echo -e "${RED}Error: Unknown command '$COMMAND'${NC}" >&2
        usage
        exit 1
        ;;
esac
