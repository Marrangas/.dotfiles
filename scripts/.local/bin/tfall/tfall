#!/usr/bin/env bash

readonly bold=$(tput bold)
readonly normal=$(tput sgr0)

set -eEo pipefail

ctrl_c() {
	printf "\n%s[ ] Force Exit%s\n\n" "$bold" "$normal"
	tput cnorm >/dev/null 2>&1
	find "$TF_PATH" -type f -name "*.tfplan" -exec rm -f {} +
	exit 1
}
trap ctrl_c INT

setup() {
	mkdir -p "/tmp/tfall/${THIS_PATH}"
	rm -f "/tmp/tfall/${THIS_PATH}/"* >/dev/null 2>&1
}

ask_confirm() {
	printf "%s [Yes/No]: " "$1"
	read -r response
	case "$response" in
		[yY][eE][sS]|[yY]) return 0 ;;
		*) return 1 ;;
	esac
}

TF_PATH=$(dirname "$0")
THIS_PATH=$(basename "$PWD")
export THIS_PATH

USER_DEPTH=1
EXCLUDE_DIRS="^.$ .git .terraform modules poc docs deprecated templates"
MODE=""
TARGET_DIRS=""
AUTO_APPROVE=0

usage() {
	printf "Usage: %s [OPTIONS] [DIRECTORIES...]\n" "$0"
	printf "Options:\n"
	printf "  %s-h, --help%s              Display this help message\n" "$bold" "$normal"
	printf "  %s-p, --plan%s              Plan all matching terraform directories\n" "$bold" "$normal"
	printf "  %s-a, --apply%s             Apply all matching planned terraform state files\n" "$bold" "$normal"
	printf "\n"
	printf "  %s-y, --auto-approve%s      Auto-approve planning (bypass confirmation prompt)\n" "$bold" "$normal"
	printf "  %s--depth%s     <num>       Max depth of directory search:\n" "$bold" "$normal"
	printf "                                0 = current directory only\n"
	printf "                                1 = immediate subdirectories\n"
	printf "                                2 = nested subdirectories up to 2 levels (default: 2)\n"
	printf "\nIf DIRECTORIES or regex filters are specified (e.g. \".*\" or \"infra\"), only matching paths will be processed.\n"
}

EXCLUDE_REGEX=""
for dir in "${EXCLUDE_DIRS[@]}"; do
	if [ "$EXCLUDE_REGEX" = "" ]; then
		EXCLUDE_REGEX="$dir"
	else
		EXCLUDE_REGEX="$EXCLUDE_REGEX|$dir"
	fi
done

get_tf_dirs() {
	MAX_DEPTH=$((USER_DEPTH + 1))
	find . -maxdepth "$MAX_DEPTH" -type f -name "*.tf" -print 2>/dev/null | \
		sed -E "s|^\./||" | \
		grep -vE "($EXCLUDE_REGEX)" | \
		while read -r file; do
			dirname "$file"
		done | sort -u
}

match_target_dirs() {
	dir_to_check="$1"
	if [ "$TARGET_DIRS" = "" ]; then
		return 0
	fi

	for pattern in "${TARGET_DIRS[@]}"; do
		pat_norm=$(printf "%s" "$pattern" | sed 's|^\./||')
		dir_norm=$(printf "%s" "$dir_to_check" | sed 's|^\./||')

		if [ "$dir_norm" = "$pat_norm" ] || printf "%s\n" "$dir_norm" | grep -qE "$pat_norm"; then
			return 0
		fi
	done

	return 1
}

get_dirs() {
	get_tf_dirs | while read -r dir; do
		if match_target_dirs "$dir"; then
			printf "%s\n" "$dir"
		fi
	done
}

tf_init() {
	ws_name="$1"
	rel_path="$2"
	orig_dir="$3"
	err_file="/tmp/tfall/${THIS_PATH}/${ws_name}@${rel_path}.err"
	err_path_file="/tmp/tfall/${THIS_PATH}/${ws_name}@${rel_path}.errpath"

	TF_INIT=$(terraform init -upgrade -no-color 2>&1)
	if printf "%s\n" "$TF_INIT" | grep -q "^Error:"; then
		printf "INIT: State workspace %s has some errors\n" "$ws_name"
		printf "EL ESTADO TIENE ERRORES AL HACER INIT\n" > "$err_file"
		printf "%s\n" "$TF_INIT" >> "$err_file"
		printf "%s\n" "$orig_dir" > "$err_path_file"
		return 1
	else
		printf "\tRunning terraform init %s\n" "$ws_name"
		return 0
	fi
}

tf_plan() {
	ws_name="$1"
	rel_path="$2"
	orig_dir="$3"
	temp_file="/tmp/tfall/${THIS_PATH}/${ws_name}@${rel_path}.tfshow"
	path_file="/tmp/tfall/${THIS_PATH}/${ws_name}@${rel_path}.apply"
	err_file="/tmp/tfall/${THIS_PATH}/${ws_name}@${rel_path}.err"
	err_path_file="/tmp/tfall/${THIS_PATH}/${ws_name}@${rel_path}.errpath"

	TF_PLAN=$(terraform plan -lock=false -out="${ws_name}.tfplan" -no-color 2>&1)
	if printf "%s\n" "$TF_PLAN" | grep -q "Error:"; then
		printf "PLAN: State workspace %s has some errors\n" "$ws_name"
		printf "EL ESTADO TIENE ERRORES AL HACER PLAN EN %s\n" "$ws_name" > "$err_file"
		printf "%s\n" "$TF_PLAN" >> "$err_file"
		printf "%s\n" "$orig_dir" > "$err_path_file"
	elif printf "%s\n" "$TF_PLAN" | grep -q "No changes."; then
		printf "\tUPDATED: Skipping tfshow for workspace %s\n" "$ws_name"
	else
		printf "\tRunning plan on workspace %s\n" "$ws_name"
		printf "%s\n" "$orig_dir" > "$path_file"
		terraform show -no-color "${ws_name}.tfplan" | tail -n +6 | tee "$temp_file"
	fi
}

loop_workspace() {
	dir="$1"
	# Replace slashes with double underscores for unique names to avoid race condition collisions in /tmp/tfall/
	rel_path=$(printf "%s" "$dir" | sed 's|^\./||; s|/|__|g')

	(
		cd "$dir" || exit 1
		printf "\nTerraform executing in %s\n" "$dir"

		tf_clean=0
		if [ -d ".terraform" ]; then
			printf "\tyou have already a .terraform directory\n"
			printf "\tthis directory will not be removed\n"
			tf_clean=1
		fi

		# Run tf_init only once per directory!
		if ! tf_init "full_environment" "$rel_path" "$dir"; then
			exit 1
		fi

		workspaces=$(terraform workspace list 2>/dev/null | sed 's/^[* ]*//' | grep -v '^default$' | grep -v '^$')

		if [ "$workspaces" != "" ]; then
			for ws in "${workspaces[@]}"; do
				terraform workspace select "$ws" >/dev/null 2>&1 || continue
				tf_plan "$ws" "$rel_path" "$dir"
			done
		else
			tf_plan "default" "$rel_path" "$dir"
		fi

		if [ "$tf_clean" -eq 0 ]; then
			rm -rf ".terraform"
		fi

		find . -maxdepth 1 -type f -name "*.tfplan" -exec rm -f {} +
	)
}

# Internal loop workspace helper for parallel execution
if [ "$1" = "--loop-workspace-helper" ]; then
	loop_workspace "$2"
	exit $?
fi

tf_apply() {
	temp_dir="/tmp/tfall/${THIS_PATH}"
	if [ ! -d "$temp_dir" ]; then
		printf "No planned workspaces found. Did you run plan first?\n" >&2
		return 1
	fi

	applied_count=0
	for path_file in "$temp_dir"/*.apply; do
		[ -f "$path_file" ] || continue

		PROJECT=$(cat "$path_file")

		# Filter using unified match logic
		if ! match_target_dirs "$PROJECT"; then
			continue
		fi

		filename=$(basename "$path_file" .apply)
		ENVIRONMENT=${filename%%@*}

		printf "Applying workspace %s in project %s...\n" "$ENVIRONMENT" "$PROJECT"
		terraform -chdir="$PROJECT" init -upgrade

		if [ "$ENVIRONMENT" = "default" ]; then
			terraform -chdir="$PROJECT" apply
		else
			(
				cd "$PROJECT" || exit 1
				terraform workspace select "$ENVIRONMENT"
				terraform apply
			)
		fi
		applied_count=$((applied_count + 1))
	done

	if [ "$applied_count" -eq 0 ]; then
		printf "No matching planned workspaces found to apply.\n"
	fi
}

options() {
	while [ $# -gt 0 ]; do
		case "$1" in
			-h | --help)
				usage
				exit 0
				;;

			--path)
				shift
				# Ignored in original logic but parsed
				;;

			--depth)
				shift
				USER_DEPTH="$1"
				;;

			-y | --auto-approve)
				AUTO_APPROVE=1
				;;

			-p | --plan)
				MODE="plan"
				;;

			-a | --apply)
				MODE="apply"
				;;

			-*)
				printf "Invalid option: %s%s%s\n" "$bold" "$1" "$normal" >&2
				usage
				exit 1
				;;

			*)
				# Accumulate positional arguments as target directories/filters
				if [ "$TARGET_DIRS" = "" ]; then
					TARGET_DIRS="$1"
				else
					TARGET_DIRS="$TARGET_DIRS $1"
				fi
				;;
		esac
		shift
	done

	# Execute based on selected mode
	if [ "$MODE" = "plan" ]; then
		setup || exit 1

		# Ensure parallel is installed
		if ! command -v parallel >/dev/null 2>&1; then
			printf "Error: GNU Parallel is required but not installed.\n" >&2
			exit 1
		fi

		# Verify that directories match the target filters
		matched_dirs=$(get_dirs)
		if [ "$matched_dirs" = "" ]; then
			printf "No directories matched the specified filters or paths.\n"
			exit 0
		fi

		printf "%sPlanning the following terraform directories:%s\n" "$bold" "$normal"
		get_dirs

		if [ "$AUTO_APPROVE" -eq 1 ]; then
			printf "AUTO-APPROVED: EXECUTING PLAN\n"
		else
			printf "%sDo you want to run terraform plan on the listed directories?%s\n" "$bold" "$normal"
			if ask_confirm "CONFIRM PLAN"; then
				printf "EXECUTING PLAN\n"
				sleep 1
			else
				printf "%sPLAN CANCELLED%s\n" "$bold" "$normal"
				exit 2
			fi
		fi

		# Use parallel with the script itself as helper
		get_dirs | parallel -j 75% "$0" --loop-workspace-helper || exit 1

		# Post-plan summary reporting
		printf "\n%s=== PLAN SUMMARY ===%s\n" "$bold" "$normal"

		changes_found=0
		for apply_file in "/tmp/tfall/${THIS_PATH}"/*.apply; do
			if [ -f "$apply_file" ]; then
				changes_found=1
				filename=$(basename "$apply_file" .apply)
				ws=${filename%%@*}
				dir_path=$(cat "$apply_file")
				printf "Workspace %s in directory %s has pending changes.\n" "$ws" "$dir_path"
			fi
		done

		errors_found=0
		for err_file in "/tmp/tfall/${THIS_PATH}"/*.err; do
			if [ -f "$err_file" ]; then
				errors_found=1
				filename=$(basename "$err_file" .err)
				ws=${filename%%@*}
				dir_path=$(cat "/tmp/tfall/${THIS_PATH}/${filename}.errpath" 2>/dev/null)
				printf "\n%s[ERROR] Workspace %s for directory %s:%s\n" "$bold" "$ws" "$dir_path" "$normal"
				cat "$err_file"
				printf "\n"
			fi
		done

		if [ "$changes_found" -eq 0 ] && [ "$errors_found" -eq 0 ]; then
			printf "No changes detected across all directories.\n"
		fi

	elif [ "$MODE" = "apply" ]; then
		tf_apply
	else
		usage
		exit 0
	fi
}

if [ "$1" = "" ]; then
	usage
	exit 0
fi

options "$@"

