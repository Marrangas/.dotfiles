#!/bin/bash

# --- 1. Path Resolution ---
# Safely resolve the physical directory of this script, even through symlinks
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

VENV_DIR="$DIR/.venv"
PYTHON_BIN="$VENV_DIR/bin/python"
REQ_FILE="$DIR/requirements.txt"

# --- 2. Self-Bootstrap Logic ---

# Check if venv exists, if not create it
if [ ! -d "$VENV_DIR" ]; then
    echo "🏗️  Creating private virtual environment in $VENV_DIR..."
    python3 -m venv "$VENV_DIR" || { echo "❌ Error: Failed to create venv. Is python3 installed?"; exit 1; }
fi

# Check if we need to install/update dependencies
# Logic: If requirements.txt is newer than the python binary, we update
if [ -f "$REQ_FILE" ]; then
    if [ ! -f "$PYTHON_BIN" ] || [ "$REQ_FILE" -nt "$PYTHON_BIN" ]; then
        echo "📦 Installing/Updating dependencies from requirements.txt..."
        "$PYTHON_BIN" -m pip install --upgrade pip > /dev/null
        "$PYTHON_BIN" -m pip install -r "$REQ_FILE" || { echo "❌ Error: Failed to install requirements."; exit 1; }
        # Touch the binary to mark it as updated
        touch "$PYTHON_BIN"
    fi
fi

# --- 3. Execution ---

# Verify the binary exists before the final jump
if [ ! -x "$PYTHON_BIN" ]; then
    echo "❌ Error: Python binary not found at $PYTHON_BIN"
    exit 1
fi

# Use 'exec' to replace the shell process with the python process
# We pass "$@" to allow things like --help or file paths to be passed through
exec "$PYTHON_BIN" "$DIR/iapt.py" "$@"
