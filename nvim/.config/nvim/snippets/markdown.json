        ],
        "description": "HTML kbd element snippet"
    },
    "htmlmark": {
        "prefix": "htmlmark",
        "body": [
            "<mark style=\"background-color: #fcf8e3; border-radius: 4px; padding: 2px 4px;\">texto resaltado</mark>"
        ],
        "description": "HTML mark element snippet"
    },
    "htmlemail": {
        "prefix": "htmlemail",
        "body": [
            "<a href=\"mailto:contact@marrangas.com\">",
            "  <img src=\"/static/icons/email.svg\" alt=\"Email\" class=\"h-4 w-4\" />",
            "</a>"
        ],
        "description": "HTML htmlemail snippet"
    },
    "htmlemoji": {
        "prefix": "htmlemoji",
        "body": [
            "cons emojiStates = [",
            "      {",
            "        name: 'happy',",
            "        mouth: 'M 30 55 Q 50 70 70 55',",
            "        leftEye: L_OPEN, leftWidth: 10,",
            "        rightEye: R_OPEN, rightWidth: 10,",
            "        extras: ''",
            "      },",
            "      {",
            "        name: 'wink',",
            "        mouth: 'M 28 54 Q 50 70 72 54',",
            "        leftEye: L_OPEN, leftWidth: 10,",
            "        rightEye: R_WINK, rightWidth: 4,",
            "        extras: ''",
            "      },",
            "      // oO (Surprised Asymmetric)",
            "      // Use L_OPEN/R_OPEN but change width!",
            "      {",
            "        name: 'oO',",
            "        mouth: 'M 45 60 Q 50 65 55 60',",
            "        leftEye: L_OPEN, leftWidth: 6, // Radius 3 (Dia 6)",
            "        rightEye: R_OPEN, rightWidth: 16, // Radius 8 (Dia 16)",
            "        extras: ''",
            "      },",
            "",
            "      // :S (Skeptical)",
            "      {",
            "        name: 'skeptical',",
            "        mouth: 'M 35 60 Q 45 65 50 60 Q 55 55 65 60',",
            "        leftEye: L_OPEN, leftWidth: 10,",
            "        rightEye: R_OPEN, rightWidth: 10,",
            "        extras: ''",
            "      },",
            "      // TT (Crying)",
            "      {",
            "        name: 'crying',",
            "        mouth: 'M 30 65 Q 50 55 70 65',",
            "        leftEye: L_FLAT, leftWidth: 4,",
            "        rightEye: R_FLAT, rightWidth: 4,",
            "        extras: '<path d=\"M 35 45 L 35 70\" stroke=\"black\" stroke-width=\"3\"/><path d=\"M 65 45 L 65 70\" stroke=\"black\" stroke-width=\"3\"/>'",
            "      },",
            "      // :P (Cheeky)",
            "      {",
            "        name: 'cheeky',",
            "        MOUTH: 'M 30 55 Q 50 55 70 55',",
            "        LEFTEYE: L_OPEN, LEFTWIDTH: 10,",
            "        RIGHTEYE: R_OPEN, RIGHTWIDTH: 10,",
            "        EXTRAS: '<PATH D=\"M 40 55 Q 40 75 50 75 Q 60 75 60 55\" FILL=\"BLACK\" />'",
            "      }",
            "];"
        ],
        "description": "HTML htmlemoji snippet"
    },
    "htmlgoto": {
        "prefix": "htmlgoto",
        "body": [
            "<!-- Punto de anclaje -->",
            "<div id=\"mi-seccion\"></div>",
            "",
            "<!-- Enlace al anclaje -->",
            "",
            "<a href=\"#mi-seccion\">Ir a la sección específica</a>"
        ],
        "description": "HTML htmlgoto snippet"
    },
