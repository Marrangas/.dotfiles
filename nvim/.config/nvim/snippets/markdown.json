        ],
        "description": "HTML htmlimg snippet"
    },
    "htmlprogress": {
        "prefix": "htmlprogress",
        "body": [
            "<progress value=\"70\" max=\"100\" style=\"width: 100%; height: 20px;\"></progress>",
            "<div style=\"display: flex; justify-content: space-between; font-size: 0.8em; color: gray;\">",
            "  <span>0%</span>",
            "  <span>70% completado</span>",
            "  <span>100%</span>",
            "</div>"
        ],
        "description": "HTML htmlprogress snippet"
    },
    "file_header": {
        "prefix": "header",
        "body": [
            "---",
            "layer: ${1|Minimal,Standard,Specific|}",
            "description: ${2:Short description of the file's purpose}",
            "component: ${3:Component name}",
            "dependencies: ${4:None}",
            "---"
        ],
        "description": "Deterministic Markdown Frontmatter metadata header"
    }
}
